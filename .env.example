# --- Supabase (public, safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- GitHub project sync (server-only, never expose to the browser) ---
# The GitHub username whose public repos get synced into the projects table.
GITHUB_USERNAME=apiz23
# Only repos carrying this GitHub topic are synced to the portfolio.
# Tag a repo on GitHub with this topic to include it.
GITHUB_PORTFOLIO_TOPIC=portfolio
# Optional for public repos; raises the rate limit from 60/hr to 5000/hr.
# Create a fine-grained token with read-only, public access. Leave blank to
# run unauthenticated (public repos still work).
GITHUB_TOKEN=

# --- Admin ---
# Shared secret for POST /api/projects (upload) and POST /api/projects/sync.
ADMIN_UPLOAD_SECRET=
