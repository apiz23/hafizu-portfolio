# --- Supabase (required) ---
# The public URL + anon key. Used both client-side and server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- GitHub project sync (optional, server-only) ---
# The GitHub username whose public repos appear in the sync picker.
GITHUB_USERNAME=apiz23
# Optional for public repos; raises the GitHub rate limit from 60/hr to 5000/hr.
# Create a fine-grained token with read-only, public-repo access.
GITHUB_TOKEN=

# --- Admin auth ---
# No env var needed. Admin login validates against the Supabase `tokens` table
# (columns: token, created_at, expires_at). Add a row with a strong random
# token, then log in at /projects/upload with that token.
